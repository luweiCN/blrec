[Unit]
Description=BLREC public dashboard PostgreSQL SSH tunnel
After=network-online.target
Wants=network-online.target
Before=blrec-dashboard-api.service

[Service]
Type=simple
User=blrec-dashboard-api
Group=blrec-dashboard-api
ExecStart=/usr/bin/ssh -F /etc/blrec-dashboard-api/db-tunnel-ssh.conf -NT blrec-dashboard-db
Restart=always
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
