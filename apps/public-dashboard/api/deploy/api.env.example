# API 与 PostgreSQL 均运行在 BLREC Platform PVE；不再配置 SSH 数据库隧道。
DASHBOARD_API_DATABASE_URL=postgresql://blrec_dashboard:secret@127.0.0.1:5432/blrec_dashboard
DASHBOARD_API_SOURCE_DATABASE_URL=postgresql://blrec_dashboard:secret@127.0.0.1:5432/blrec_dashboard?options=-csearch_path%3Dcore
DASHBOARD_API_SOURCE_WATCH_SECONDS=1
DASHBOARD_API_REPOSITORY_MODE=direct
DASHBOARD_API_INGEST_TOKEN_SHA256=replace-with-the-sha256-of-the-nas-token
DASHBOARD_API_CORS_ORIGINS=https://vg.luwei.host
DASHBOARD_API_PUBLIC_LISTEN_ADDRESS=192.168.50.62
