DASHBOARD_API_DATABASE_PATH=/var/lib/blrec-dashboard-api/dashboard.sqlite3
# 正式切换后使用本机 SSH 隧道，不把 PostgreSQL 端口暴露到公网。
# DASHBOARD_API_DATABASE_URL=postgresql://blrec_dashboard:secret@127.0.0.1:5433/blrec_dashboard
# Optional: use a separate read-only credential. Without it, the public role must
# have SELECT on only the tables listed in deploy/grant-core-read.sql.
# DASHBOARD_API_SOURCE_DATABASE_URL=postgresql://blrec_dashboard:secret@127.0.0.1:5433/blrec_dashboard?options=-csearch_path%3Dcore
DASHBOARD_API_SOURCE_WATCH_SECONDS=1
# Keep direct while the PostgreSQL cache is built and verified in shadow mode.
# Switch to postgres only after both public/owner cache pointers match core revision.
DASHBOARD_API_REPOSITORY_MODE=direct
DASHBOARD_API_INGEST_TOKEN_SHA256=replace-with-the-sha256-of-the-nas-token
DASHBOARD_API_CORS_ORIGINS=https://vg.luwei.host
