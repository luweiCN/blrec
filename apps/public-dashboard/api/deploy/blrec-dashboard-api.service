[Unit]
Description=BLREC public dashboard match API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blrec-dashboard-api
Group=blrec-dashboard-api
EnvironmentFile=/etc/blrec-dashboard-api/api.env
WorkingDirectory=/opt/blrec-dashboard-api/current
ExecStart=/opt/blrec-dashboard-api/current/venv/bin/blrec-dashboard-api
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blrec-dashboard-api
RestrictSUIDSGID=true
LockPersonality=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
