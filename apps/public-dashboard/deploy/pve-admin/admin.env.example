# 该文件正式安装于 /etc/blrec-dashboard-admin/admin.env，权限必须为 0600。
# 密钥只由 PVE Nginx 读取并注入到上游请求，绝不能进入浏览器构建产物。
BLREC_INTERNAL_ADMIN_API_KEY=replace-with-the-existing-blrec-api-key
BLREC_DASHBOARD_OWNER_TOKEN=replace-with-the-existing-dashboard-owner-token
BLREC_INTERNAL_ADMIN_LISTEN_ADDRESS=192.168.50.62
BLREC_INTERNAL_ADMIN_BACKEND=http://192.168.50.24:2234
